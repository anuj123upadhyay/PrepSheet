# PrepSheet Environment Configuration
# Copy this to .env and fill in your credentials

# Calendar Access (CalDAV)
CALENDAR_URL=https://caldav.provider.com/user/calendar
# CALENDAR_USERNAME=your-username
# CALENDAR_PASSWORD=your-password

# Email Access (IMAP - read-only)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your@email.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

# Hermes SMS Integration (optional)
HERMES_SMS_ENABLED=false
HERMES_SMS_NUMBER=+1234567890
# HERMES_SMS_API_KEY=your-api-key

# Plow Latch (for OSINT)
# PLOW_LATCH_ENABLED=true

# Agent Identity
AGENT_ID=PrepSheet

# Internal Domains (comma-separated, used to identify external attendees)
INTERNAL_DOMAINS=mycompany.com,internal.org
